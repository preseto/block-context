parameters:
	tmpDir: .cache/phpstan
	level: 5
	paths:
		- php
		- tests
		- block-context.php
	scanDirectories:
		- tools/wordpress
		- vendor
	ignoreErrors:
		- # WP core defines these in scanned files but they are user-configurable at runtime.
			identifier: booleanAnd.rightAlwaysTrue
			path: php/Plugin.php
