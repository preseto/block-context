{
	"name": "block-context",
	"description": "WordPress plugin for showing or hiding Gutenberg blocks in context.",
	"private": true,
	"dependencies": {
		"@wordpress/block-editor": "^16.2.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/compose": "^8.6.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/hooks": "^4.53.0",
		"@wordpress/i18n": "^6.26.0"
	},
	"devDependencies": {
		"@wordpress/env": "^11.13.0",
		"@wordpress/scripts": "^34.1.0",
		"npm-run-all2": "^9.0"
	},
	"scripts": {
		"start": "wp-env start --xdebug=debug,coverage",
		"stop": "wp-env stop",
		"cli": "wp-env run cli --env-cwd=wp-content/plugins/block-context",
		"dev": "wp-scripts start js/editor.js",
		"build": "npm-run-all build:*",
		"build:js": "wp-scripts build js/editor.js",
		"build:php": "composer install --no-plugins --no-dev --optimize-autoloader",
		"lint": "npm-run-all lint:*",
		"lint:js": "wp-scripts lint-js js",
		"lint:php": "npm run cli -- composer lint",
		"format": "npm-run-all format:*",
		"format:js": "wp-scripts format js",
		"format:php": "npm run cli -- composer format",
		"test": "npm-run-all test:*",
		"test:js": "wp-scripts test-unit-js js --passWithNoTests",
		"test:php": "npm run cli -- composer test",
		"release": "npm-run-all release:*",
		"release:build": "npm run build",
		"release:zip": "php tools/release.php"
	}
}
